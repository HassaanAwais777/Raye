# AudienceLens environment template — copy to .env and fill in.
# .env is gitignored and loaded by backend/config.py via python-dotenv.
# NEVER commit real credentials.

# --- Neon PostgreSQL ---
# Pooled runtime connection (from Neon dashboard → "Pooled connection")
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Direct connection for Alembic migrations (same as above WITHOUT "-pooler")
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# --- YouTube Data API v3 ---
# Get from https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=AIza...

# --- Google Ads API (optional — for real paid campaign metrics) ---
# Requires: pip install google-ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
