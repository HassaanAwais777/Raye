# ---- Raye configuration (copy to .env and adjust) ----

# Scale controls
RAYE_MAX_TOTAL_COMMENTS=200000      # hard ceiling per analysis
RAYE_DEFAULT_MAX_COMMENTS=3000      # UI/API default
RAYE_MIN_RELIABLE_N=150             # below this -> insufficient_evidence verdict
RAYE_IDEAL_N=2000                   # sample-size factor saturates here
RAYE_MIN_ASPECT_MENTIONS=30         # min mentions before an aspect score is trusted

# Storage & API
RAYE_DB_PATH=./raye.db
RAYE_CORS_ORIGINS=*

# Crawling behaviour (politeness)
RAYE_REQUEST_TIMEOUT=20
RAYE_USER_AGENT=Mozilla/5.0 (compatible; RayeBot/1.0; +https://github.com/HassaanAwais777/Raye)
RAYE_YT_VIDEOS_PER_QUERY=10
RAYE_YT_COMMENTS_PER_VIDEO=150
RAYE_REDDIT_POSTS_PER_QUERY=15
RAYE_REDDIT_COMMENTS_PER_POST=100
